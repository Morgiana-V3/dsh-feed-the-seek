{
  "name": "dsh-feed-the-seek",
  "version": "0.2.16",
  "license": "MIT",
  "description": "大肥鱼饲养手册：从聊天与工作中积累认知、经历与相处记忆，跨会话记住你的习惯，结合近期情绪与自我观察调整表达和协作方式。默认本地检索，可选向量语义增强。",
  "type": "module",
  "main": "dist/src/dsh.js",
  "exports": {
    ".": "./dist/src/dsh.js",
    "./client": "./public/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "public/client.js",
    "public/native.css",
    "public/index.html",
    "public/app.js",
    "public/style.css",
    "public/assets/portrait-*.png",
    "public/assets/portrait-*.webp",
    "public/assets/plugin-icon-v6.png",
    "public/assets/fonts/zpix-v3.3.0.woff2",
    "public/assets/fonts/ZPIX-UPSTREAM-README.md",
    "public/assets/ARTWORK.md",
    "cordis.patch.yml",
    "README.md",
    "docs/**/*.md",
    "docs/screenshots/market-intro-v2-a.png",
    "docs/screenshots/overview.png",
    "docs/screenshots/memories.png",
    "docs/screenshots/history.png",
    "docs/screenshots/settings.png",
    "docs/screenshots/emotions.png",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "build": "node scripts/build/build.mjs",
    "start": "node dist/src/server.js",
    "dev": "npm run build && npm start",
    "dev:dsh": "node scripts/development/dev-desktop.mjs",
    "dev:dsh:stop": "node scripts/development/dev-desktop.mjs --release",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "check": "tsc --noEmit",
    "check:release": "node scripts/release/check-release.mjs",
    "prepack": "npm run build && npm run check:release",
    "format": "prettier --write src tests scripts public/app.js public/*.css public/index.html package.json tsconfig.json *.mjs .prettierrc.json",
    "format:check": "prettier --check src tests scripts public/app.js public/*.css public/index.html package.json tsconfig.json *.mjs .prettierrc.json",
    "lint": "eslint src tests scripts public/app.js",
    "lint:fix": "npm run lint -- --fix",
    "lint:styles": "stylelint \"public/*.css\"",
    "lint:styles:fix": "npm run lint:styles -- --fix",
    "check:all": "npm run format:check && npm run lint && npm run lint:styles && npm run check:boundaries && npm run check",
    "check:boundaries": "node scripts/checks/check-boundaries.mjs"
  },
  "dependencies": {
    "sqlite-vec": "0.1.6",
    "ts-dedent": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stylelint": "^17.16.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "icon": "public/assets/plugin-icon-v6.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Morgiana-V3/dsh-feed-the-seek.git"
  },
  "homepage": "https://github.com/Morgiana-V3/dsh-feed-the-seek#readme",
  "bugs": {
    "url": "https://github.com/Morgiana-V3/dsh-feed-the-seek/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "companion",
    "local-first"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
