{
  "name": "dsh-feed-the-seek",
  "version": "0.2.15-beta.1",
  "private": true,
  "description": "大肥鱼饲养手册：从聊天与工作中积累认知、经历与相处记忆，跨会话记住你的习惯，结合近期情绪与自我观察调整表达和协作方式。默认本地检索，可选向量语义增强。",
  "type": "module",
  "main": "dist/src/dsh.js",
  "exports": {
    ".": "./dist/src/dsh.js",
    "./client": "./public/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "public/client.js",
    "public/native.css",
    "public/index.html",
    "public/app.js",
    "public/style.css",
    "public/assets/portrait-*.png",
    "public/assets/plugin-icon-v5.png",
    "public/assets/fonts/zpix-v3.3.0.woff2",
    "public/assets/fonts/ZPIX-UPSTREAM-README.md",
    "public/assets/ARTWORK.md",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "build": "tsc && node scripts/build-client.mjs",
    "start": "node dist/src/server.js",
    "dev": "npm run build && npm start",
    "dev:dsh": "node scripts/dev-desktop.mjs",
    "dev:dsh:stop": "node scripts/dev-desktop.mjs --release",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "tsc --noEmit",
    "check:release": "node scripts/check-release.mjs",
    "prepack": "npm run build && npm run check:release"
  },
  "dependencies": {
    "sqlite-vec": "0.1.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3"
  },
  "icon": "public/assets/plugin-icon-v5.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "companion",
    "local-first"
  ]
}
